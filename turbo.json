{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "remoteCache": {
    "teamSlug": "ui-kit",
    "apiUrl": "https://djcopdhbb4ijlio2hgabt64kjy0lxwet.lambda-url.us-east-1.on.aws"
  },
  "futureFlags": {
    "affectedUsingTaskInputs": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/__tests__/**",
        "!**/*.md",
        "!**/LICENSE*",
        "!**/.vscode/**",
        "!**/catalog-info*.yaml"
      ],
      "outputs": [
        "dist/**",
        "cdn/**",
        "docs/**",
        "temp/**",
        "coverage/**",
        ".next/**",
        "!.next/cache/**",
        "**/*.tsbuildinfo"
      ]
    },
    "build:typedoc": {
      "dependsOn": ["^build"],
      "outputs": ["docs/**", "!docs/adr/**"]
    },
    "publint": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "prod": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/LICENSE*",
        "!**/.vscode/**",
        "!**/catalog-info*.yaml"
      ],
      "outputs": []
    },
    "functional-test": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/LICENSE*",
        "!**/.vscode/**",
        "!**/catalog-info*.yaml"
      ],
      "outputs": []
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "e2e": {
      "dependsOn": ["build"],
      "outputs": ["playwright-report/**"]
    },
    "lint": {
      "outputs": []
    },
    "lint:check": {
      "outputs": []
    },
    "lint:fix": {
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  },
  "globalDependencies": [
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    ".npmrc",
    "tsconfig.json",
    ".oxlintrc.json",
    ".oxfmtrc.json",
    ".cspell.json"
  ],
  "globalEnv": ["DEPLOYMENT_ENVIRONMENT", "NODE_ENV", "CI", "CDN_COMMIT_SHA"],
  "globalPassThroughEnv": ["GITHUB_*", "RUNNER_*", "SFDX_*", "PLAYWRIGHT_BROWSERS_PATH"]
}
