{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "remoteCache": {
    "teamSlug": "ui-kit",
    "apiUrl": "https://djcopdhbb4ijlio2hgabt64kjy0lxwet.lambda-url.us-east-1.on.aws"
  },
  "futureFlags": {
    "affectedUsingTaskInputs": true
  },
  "tasks": {
    "//#generate:agents-md-packages": {
      "inputs": [
        "AGENTS.md",
        "packages/**/package.json",
        "scripts/generate/agents-md-packages.mjs",
        "scripts/packages.mjs"
      ],
      "outputs": ["AGENTS.md"]
    },
    "//#generate:catalog-info": {
      "inputs": [
        "packages/*/package.json",
        "packages/*/catalog-info.config.yaml",
        "catalog-info.ui-kit.config.yaml",
        "scripts/generate/catalog-info.mjs",
        "packages/*/catalog-info.yaml",
        "catalog-info.yaml",
        "catalog-info.ui-kit.yaml"
      ],
      "outputs": ["packages/*/catalog-info.yaml", "catalog-info.yaml", "catalog-info.ui-kit.yaml"]
    },
    "//#generate:all": {
      "dependsOn": ["//#generate:agents-md-packages", "//#generate:catalog-info"]
    },
    "//#lint:check:oxlint": {
      "outputs": []
    },
    "//#lint:check:oxfmt": {
      "outputs": []
    },
    "//#lint:check:cspell": {
      "outputs": []
    },
    "//#lint:check:all": {
      "dependsOn": ["//#lint:check:oxlint", "//#lint:check:oxfmt", "//#lint:check:cspell"],
      "outputs": []
    },
    "//#lint:fix:oxlint": {
      "outputs": []
    },
    "//#lint:fix:oxfmt": {
      "outputs": []
    },
    "//#lint:fix:all": {
      "dependsOn": ["//#lint:fix:oxlint", "//#lint:fix:oxfmt", "//#lint:check:cspell"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/__tests__/**",
        "!**/*.md",
        "!**/LICENSE*",
        "!**/.vscode/**",
        "!**/catalog-info*.yaml"
      ],
      "outputs": [
        "dist/**",
        "cdn/**",
        "docs/**",
        "temp/**",
        "coverage/**",
        ".next/**",
        "!.next/cache/**",
        "**/*.tsbuildinfo"
      ]
    },
    "build:typedoc": {
      "dependsOn": ["^build"],
      "outputs": ["docs/**", "!docs/adr/**"]
    },
    "publint": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "prod": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/LICENSE*",
        "!**/.vscode/**",
        "!**/catalog-info*.yaml"
      ],
      "outputs": []
    },
    "functional-test": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/LICENSE*",
        "!**/.vscode/**",
        "!**/catalog-info*.yaml"
      ],
      "outputs": []
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "e2e": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["playwright-report/**", "blob-report/**", "test-results/**"]
    },
    "lint": {
      "outputs": []
    },
    "lint:check:all": {
      "dependsOn": ["//#lint:check:all"],
      "outputs": []
    },
    "lint:fix:all": {
      "dependsOn": ["//#lint:fix:all"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  },
  "globalDependencies": [
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    ".npmrc",
    "tsconfig.json",
    ".oxlintrc.json",
    ".oxfmtrc.json",
    ".cspell.json"
  ],
  "globalEnv": ["DEPLOYMENT_ENVIRONMENT", "NODE_ENV", "CI", "CDN_COMMIT_SHA"],
  "globalPassThroughEnv": ["GITHUB_*", "RUNNER_*", "SFDX_*", "PLAYWRIGHT_BROWSERS_PATH"]
}
