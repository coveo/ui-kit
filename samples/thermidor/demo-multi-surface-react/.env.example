# Leave everything unset to run against the mock (`pnpm dev`), on http://localhost:3456.
#
# Against an Agent Gateway that serves the Storefront Preview route (`pnpm dev:vite`):
# VITE_COVEO_ENDPOINT=<the route's full converse URL, or a same-origin /api/... path with the proxy>
# VITE_GATEWAY_PROXY_TARGET=<the gateway's origin, to proxy /api to it, e.g. http://127.0.0.1:8990>
# VITE_COVEO_ORGANIZATION_ID=<organization ID>
# VITE_COVEO_ACCESS_TOKEN=<a token the gateway accepts for that organization>
# VITE_COVEO_AGENT_CONFIGURATION_ID=<the agent configuration ID the route serves>
# VITE_COVEO_TRACKING_ID=<a tracking ID of that organization>
