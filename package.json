{
  "name": "ui-kit",
  "version": "3.0.100",
  "private": true,
  "description": "Monorepo for Coveo UI packages, shared tooling, and release workflows",
  "scripts": {
    "postinstall": "husky install",
    "pnpm:devPreinstall": "pnpm turbo:login",
    "turbo:login": "node scripts/turboLogin.mjs",
    "reset:install": "git checkout origin/main pnpm-lock.yaml && pnpm install",
    "clean:install": "git clean -xfd && pnpm run reset:install",
    "dev:atomic": "concurrently \"pnpm --filter @coveo/headless dev\" \"pnpm --filter @coveo/atomic start\"",
    "build": "turbo build",
    "test": "turbo test",
    "e2e": "turbo e2e",
    "lint:check:oxlint": "oxlint --deny-warnings .",
    "lint:check:oxfmt": "oxfmt --check .",
    "lint:check:cspell": "cspell '**/*.md' --no-progress --show-suggestions --show-context",
    "lint:check": "turbo run lint:check:all",
    "lint:fix:oxlint": "oxlint --deny-warnings --fix .",
    "lint:fix:oxfmt": "oxfmt .",
    "lint:fix": "turbo run lint:fix:all",
    "report:bundle-size:time-series": "node ./scripts/reports/bundle-size/time-series.mjs",
    "report:catalog:candidates": "node ./scripts/report-catalog-candidates.mjs",
    "pre-commit": "lint-staged",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "notify:docs": "node ./scripts/notify-docs/published-ui-kit.mjs",
    "release": "pnpm run build && changeset publish",
    "knip": "knip",
    "generate": "turbo run generate:all",
    "generate:catalog-info": "node scripts/generate/catalog-info.mjs",
    "generate:agents-md-packages": "node scripts/generate/agents-md-packages.mjs",
    "generate:turbo-lint-inputs": "node scripts/generate/turbo-lint-inputs.mjs"
  },
  "devDependencies": {
    "@actions/github": "9.1.1",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "@cspell/dict-fr-fr": "2.3.2",
    "@playwright/mcp": "catalog:",
    "@tsconfig/node22": "22.0.5",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "concurrently": "9.2.4",
    "cspell": "9.8.0",
    "esbuild": "catalog:",
    "husky": "9.1.7",
    "knip": "6.32.2",
    "lint-staged": "16.4.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "playwright": "catalog:",
    "semver": "7.8.5",
    "turbo": "2.10.9",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": "^22.14.0 || ^24.11.0",
    "pnpm": ">=11.17.0"
  },
  "packageManager": "pnpm@11.17.0"
}
