{
  "name": "@coveo/atomic-react",
  "version": "3.11.41",
  "description": "React specific wrapper for the Atomic component library",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coveo/ui-kit.git",
    "directory": "packages/atomic-react"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/atomic-react.cjs",
  "module": "./dist/esm/atomic-react.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/atomic-react.mjs",
      "require": "./dist/cjs/atomic-react.cjs"
    },
    "./commerce": {
      "types": "./dist/types/commerce.index.d.ts",
      "import": "./dist/esm/commerce/atomic-react.mjs",
      "require": "./dist/cjs/commerce/atomic-react.cjs"
    },
    "./recommendation": {
      "types": "./dist/types/recommendation.index.d.ts",
      "import": "./dist/esm/recommendation/atomic-react.mjs",
      "require": "./dist/cjs/recommendation/atomic-react.cjs"
    }
  },
  "scripts": {
    "publint": "publint",
    "clean": "node ../../utils/ci/rm-rf.mjs dist",
    "gen:lit": "node ./scripts/build-lit.mjs",
    "build:bundles": "rollup --config rollup.config.js",
    "build:types": "tsc --project tsconfig.types.json",
    "build:assets": "node ../../utils/ci/copy-files.mjs ../atomic/dist/assets dist/assets ../atomic/dist/lang dist/lang"
  },
  "dependencies": {
    "@coveo/atomic": "workspace:*",
    "@lit/react": "1.0.8"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "catalog:",
    "@rollup/plugin-json": "catalog:",
    "@rollup/plugin-node-resolve": "catalog:",
    "@rollup/plugin-typescript": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rollup": "catalog:",
    "rollup-plugin-polyfill-node": "^0.13.0"
  },
  "peerDependencies": {
    "@coveo/headless": "workspace:^",
    "@types/react": "catalog:peer-compatibility",
    "@types/react-dom": "catalog:peer-compatibility",
    "react": "catalog:peer-compatibility",
    "react-dom": "catalog:peer-compatibility"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.9.0 || ^22.11.0 || ^24.11.0"
  }
}
