{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.thermidor.coveo.com/components/facet-manager.schema.json",
  "title": "FacetManager",
  "description": "Manages facet ordering and cross-facet concerns. Holds the backend-determined order of facet components as state. The position of each identifier (indexed from 0) determines the facet's rendering rank. Ready to gain cross-facet actions (e.g., clear all facets, reorder) as needs arise.",
  "allOf": [
    {
      "$ref": "https://schema.thermidor.coveo.com/base/component.schema.json"
    }
  ],
  "properties": {
    "componentType": {
      "type": "string",
      "const": "facet-manager"
    },
    "state": {
      "$ref": "#/$defs/FacetManagerState"
    },
    "actions": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "children": {
      "type": "array",
      "items": {
        "$ref": "https://schema.thermidor.coveo.com/definitions/child-ref.schema.json"
      },
      "maxItems": 1000,
      "default": []
    },
    "child": {
      "$ref": "https://schema.thermidor.coveo.com/definitions/child-ref.schema.json"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "SnapshotEntry": {
      "title": "FacetManagerSnapshotEntry",
      "type": "object",
      "required": ["componentType", "state", "actions"],
      "properties": {
        "componentType": {
          "type": "string",
          "const": "facet-manager"
        },
        "state": {
          "$ref": "#/$defs/FacetManagerState"
        },
        "actions": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "https://schema.thermidor.coveo.com/definitions/child-ref.schema.json"
          },
          "maxItems": 1000,
          "default": []
        },
        "child": {
          "$ref": "https://schema.thermidor.coveo.com/definitions/child-ref.schema.json"
        }
      },
      "additionalProperties": false
    },
    "FacetManagerState": {
      "title": "FacetManagerState",
      "description": "The facet manager state. Holds the ordered list of facet component identifiers. Owned exclusively by the backend.",
      "type": "object",
      "required": ["facetIds"],
      "properties": {
        "facetIds": {
          "type": "array",
          "description": "Ordered facet component identifiers. Position (indexed from 0) determines the facet's rendering rank. Each identifier is expected to match the 'componentId' of a facet component registered in the catalog; referential integrity is enforced outside JSON Schema.",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
