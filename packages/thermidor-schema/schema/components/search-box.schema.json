{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.thermidor.coveo.com/components/search-box.schema.json",
  "title": "SearchBox",
  "description": "Provides a search input for a commerce search surface. Renders the current query and dispatches submitQuery when the user submits a new query.",
  "allOf": [{"$ref": "https://schema.thermidor.coveo.com/base/component.schema.json"}],
  "properties": {
    "componentType": {
      "type": "string",
      "const": "search-box"
    },
    "state": {"$ref": "#/$defs/SearchBoxState"},
    "actions": {
      "type": "object",
      "required": ["submitQuery"],
      "properties": {
        "submitQuery": {"$ref": "#/$defs/SubmitQueryAction"}
      },
      "additionalProperties": false
    },
    "children": {
      "type": "array",
      "items": {
        "$ref": "https://schema.thermidor.coveo.com/definitions/child-ref.schema.json"
      },
      "maxItems": 1000,
      "default": []
    },
    "child": {
      "$ref": "https://schema.thermidor.coveo.com/definitions/child-ref.schema.json"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Triad": {
      "title": "SearchBoxTriad",
      "type": "object",
      "required": ["componentType", "state", "actions"],
      "properties": {
        "componentType": {
          "type": "string",
          "const": "search-box"
        },
        "state": {"$ref": "#/$defs/SearchBoxState"},
        "actions": {
          "type": "object",
          "required": ["submitQuery"],
          "properties": {
            "submitQuery": {"$ref": "#/$defs/SubmitQueryAction"}
          },
          "additionalProperties": false
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "https://schema.thermidor.coveo.com/definitions/child-ref.schema.json"
          },
          "maxItems": 1000,
          "default": []
        },
        "child": {
          "$ref": "https://schema.thermidor.coveo.com/definitions/child-ref.schema.json"
        }
      },
      "additionalProperties": false
    },
    "SearchBoxState": {
      "title": "SearchBoxState",
      "description": "The current search box state. Owned exclusively by the backend.",
      "type": "object",
      "required": ["query"],
      "properties": {
        "query": {
          "type": "string",
          "description": "The current search query string."
        }
      },
      "additionalProperties": false
    },
    "SubmitQueryAction": {
      "title": "submitQuery",
      "description": "Submits a new search query.",
      "allOf": [{"$ref": "https://schema.thermidor.coveo.com/base/action.schema.json"}],
      "properties": {
        "payload": {
          "type": "object",
          "required": ["query"],
          "properties": {
            "query": {
              "type": "string",
              "description": "The query string to submit."
            }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
