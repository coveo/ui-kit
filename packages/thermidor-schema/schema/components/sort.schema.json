{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.thermidor.coveo.com/components/sort.schema.json",
  "title": "Sort",
  "description": "Provides sort controls for a commerce search surface. Renders available sort options and dispatches selectSort when the user changes the sort order.",
  "allOf": [
    {
      "$ref": "https://schema.thermidor.coveo.com/base/component.schema.json"
    }
  ],
  "properties": {
    "componentType": {
      "type": "string",
      "const": "sort"
    },
    "state": {
      "$ref": "#/$defs/SortState"
    },
    "actions": {
      "type": "object",
      "required": ["selectSort"],
      "properties": {
        "selectSort": {
          "$ref": "#/$defs/SelectSortAction"
        }
      },
      "additionalProperties": false
    },
    "children": {
      "type": "array",
      "items": {
        "$ref": "https://schema.thermidor.coveo.com/definitions/child-ref.schema.json"
      },
      "maxItems": 1000,
      "default": []
    },
    "child": {
      "$ref": "https://schema.thermidor.coveo.com/definitions/child-ref.schema.json"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "SnapshotEntry": {
      "title": "SortSnapshotEntry",
      "type": "object",
      "required": ["componentType", "state", "actions"],
      "properties": {
        "componentType": {
          "type": "string",
          "const": "sort"
        },
        "state": {
          "$ref": "#/$defs/SortState"
        },
        "actions": {
          "type": "object",
          "required": ["selectSort"],
          "properties": {
            "selectSort": {
              "$ref": "#/$defs/SelectSortAction"
            }
          },
          "additionalProperties": false
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "https://schema.thermidor.coveo.com/definitions/child-ref.schema.json"
          },
          "maxItems": 1000,
          "default": []
        },
        "child": {
          "$ref": "https://schema.thermidor.coveo.com/definitions/child-ref.schema.json"
        }
      },
      "additionalProperties": false
    },
    "SortState": {
      "title": "SortState",
      "description": "The current sort state. Owned exclusively by the backend.",
      "type": "object",
      "required": ["appliedSort", "availableSorts"],
      "properties": {
        "appliedSort": {
          "$ref": "#/$defs/SortCriterion",
          "description": "The currently applied sort criterion."
        },
        "availableSorts": {
          "type": "array",
          "description": "All available sort options.",
          "items": {
            "$ref": "#/$defs/SortCriterion"
          }
        }
      },
      "additionalProperties": false
    },
    "SortCriterion": {
      "title": "SortCriterion",
      "description": "A sort criterion consisting of a named criteria and field definitions.",
      "type": "object",
      "required": ["sortCriteria", "fields"],
      "properties": {
        "sortCriteria": {
          "type": "string",
          "description": "The name of the sort criterion (e.g. 'relevance', 'price asc')."
        },
        "fields": {
          "type": "array",
          "description": "The fields involved in this sort criterion."
        }
      },
      "additionalProperties": false
    },
    "SelectSortAction": {
      "title": "selectSort",
      "description": "Applies a new sort criterion.",
      "allOf": [
        {
          "$ref": "https://schema.thermidor.coveo.com/base/action.schema.json"
        }
      ],
      "properties": {
        "payload": {
          "type": "object",
          "required": ["sortCriteria", "fields"],
          "properties": {
            "sortCriteria": {
              "type": "string",
              "description": "The sort criterion to apply."
            },
            "fields": {
              "type": "array",
              "description": "The fields involved in the sort criterion."
            }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
