{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.thermidor.coveo.com/components/product-carousel.schema.json",
  "title": "ProductCarousel",
  "description": "Renders an ordered list of commerce products for a single category or intent bucket. Read-only from the frontend: the backend is the sole source of truth for which products are displayed and in what order.",
  "allOf": [{"$ref": "https://schema.thermidor.coveo.com/base/component.schema.json"}],
  "properties": {
    "controllers": {
      "type": "object",
      "required": ["productListController"],
      "properties": {
        "productListController": {
          "$ref": "https://schema.thermidor.coveo.com/controllers/product-list.schema.json"
        }
      },
      "additionalProperties": false
    }
  }
}
