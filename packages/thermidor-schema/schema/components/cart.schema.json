{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.thermidor.coveo.com/components/cart.schema.json",
  "title": "Cart",
  "description": "Renders the current cart contents and exposes actions for the frontend to manage line items. Cart state is owned by the backend; all mutations flow through declared actions.",
  "allOf": [{"$ref": "https://schema.thermidor.coveo.com/base/component.schema.json"}],
  "properties": {
    "controllers": {
      "type": "object",
      "required": ["cartController"],
      "properties": {
        "cartController": {
          "$ref": "https://schema.thermidor.coveo.com/controllers/cart.schema.json"
        }
      },
      "additionalProperties": false
    }
  }
}
