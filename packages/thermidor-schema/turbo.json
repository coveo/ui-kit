{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "validate:schema": {
      "inputs": ["schema/**/*.json", "scripts/validate-schema.ts"],
      "outputs": []
    },
    "generate": {
      "dependsOn": ["validate:schema"],
      "inputs": ["schema/**/*.json", "scripts/generate-zod.ts"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["generate"],
      "inputs": ["src/**/*.ts", "tsconfig.json"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"]
    }
  }
}
