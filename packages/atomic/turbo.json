{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["tsc:check", "build:storybook", "build:lit", "build:cdn"],
      "outputs": []
    },
    "build:locales": {
      "outputs": ["dist/lang/**", "src/assets/lang/**", "src/generated/**"],
      "inputs": ["src/locales.json"]
    },
    "build:assets": {
      "outputs": ["dist/assets/**"],
      "inputs": ["scripts/build-assets.mjs"]
    },
    "build:themes": {
      "outputs": ["dist/themes/**"],
      "inputs": ["src/themes/**"]
    },
    "pre:storybook": {
      "dependsOn": ["build:cem", "build:locales", "build:assets", "build:indexes"],
      "outputs": []
    },
    "build:storybook": {
      "dependsOn": ["^build", "pre:storybook"],
      "outputs": ["./dist-storybook/**"],
      "env": ["STORYBOOK_INVOKED_BY"]
    },
    "chromatic": {
      "cache": false,
      "dependsOn": [],
      "outputs": [],
      "env": ["CHROMATIC_PROJECT_TOKEN", "CHROMATIC_SHA", "CHROMATIC_BRANCH", "CHROMATIC_SLUG"]
    },
    "build:cem": {
      "outputs": ["./custom-elements.json"],
      "inputs": [
        "./src/**/*.ts",
        "!./src/components/*/index.ts",
        "!./src/components/*/lazy-index.ts",
        "!./src/utils/custom-element-tags.ts",
        "!./src/**/*.spec.ts",
        "!./src/**/*.d.ts",
        "!./src/**/e2e/**"
      ]
    },
    "build:indexes": {
      "outputs": ["src/components/*/index.ts", "src/components/*/lazy-index.ts"],
      "inputs": [
        "./src/**/*.ts",
        "!./src/components/*/index.ts",
        "!./src/components/*/lazy-index.ts",
        "!./src/utils/custom-element-tags.ts",
        "!./src/**/*.spec.ts",
        "!./src/**/*.d.ts",
        "!./src/**/e2e/**"
      ]
    },
    "build:lit": {
      "dependsOn": ["^build", "build:locales", "build:indexes"],
      "outputs": [
        "src/utils/custom-element-tags.ts",
        "dist/esm/**",
        "dist/cjs/**",
        "dist/types/**",
        "docs/**"
      ],
      "inputs": [
        "./src/**/*.ts",
        "!./src/components/*/index.ts",
        "!./src/components/*/lazy-index.ts",
        "!./src/utils/custom-element-tags.ts",
        "!./src/**/*.spec.ts",
        "!./src/**/*.d.ts",
        "!./src/**/e2e/**"
      ]
    },
    "build:cdn": {
      "dependsOn": ["^build", "build:lit", "build:locales", "build:assets", "build:themes"],
      "outputs": ["cdn/**"],
      "inputs": [
        "./src/**/*.ts",
        "!./src/**/*.spec.ts",
        "!./src/**/*.d.ts",
        "!./src/**/e2e/**",
        "./dist/assets/**",
        "./dist/lang/**",
        "./dist/themes/**",
        "./rsbuild.cdn.mjs"
      ]
    },
    "tsc:check": {
      "dependsOn": ["^build", "build:locales"],
      "outputs": []
    },
    "test:lit": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:storybook": {
      "dependsOn": ["^build", "build"],
      "outputs": ["reports/a11y-report.shard-*.json", "reports/a11y-report.json"]
    },
    "dev": {
      "extends": false,
      "with": ["dev:storybook"],
      "cache": false,
      "persistent": true
    },
    "dev:storybook": {
      "dependsOn": ["@coveo/atomic-legacy#build", "pre:storybook"],
      "cache": false,
      "persistent": true
    },
    "web:dev": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "web:cdn": {
      "dependsOn": ["build:cdn"],
      "cache": false,
      "persistent": true
    },
    "e2e": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["playwright-report/**", "blob-report/**", "test-results/**"]
    },
    "e2e:csp": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "cache": false
    },
    "validate:light-dom-styles": {
      "outputs": []
    },
    "validate:no-new-light-dom": {
      "outputs": []
    }
  }
}
