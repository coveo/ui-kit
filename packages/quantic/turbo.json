{
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["build:staticresources", "build:doc", "babel:headless"],
      "outputs": []
    },
    "build:staticresources": {
      "dependsOn": ["^build", "babel:headless"],
      "outputs": [
        "force-app/main/default/staticresources/coveobueno/**",
        "force-app/main/default/staticresources/coveoheadless/**",
        "force-app/main/default/staticresources/dompurify/**",
        "force-app/main/default/staticresources/marked/**",
        "force-app/solutionExamples/main/staticresources/coveoua/**"
      ]
    },
    "build:doc": {
      "dependsOn": ["^build"],
      "outputs": ["docs/out/**"]
    },
    "babel:headless": {
      "dependsOn": ["^build"],
      "outputs": [".tmp/quantic-compiled/**"]
    },
    "promote:sfdx": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "promote:sfdx:ci": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test": {
      "outputs": [],
      "dependsOn": [
        "test:unit",
        "validate:e2e-task-contracts",
        "validate:types",
        "validate:types:build-scripts"
      ]
    },
    "test:unit": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "e2e": {
      "dependsOn": ["e2e:prepare"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.github/actions/apex-unit-tests/**",
        "$TURBO_ROOT$/.github/actions/calculate-affected/**",
        "$TURBO_ROOT$/.github/actions/e2e-quantic-setup/**",
        "$TURBO_ROOT$/.github/actions/merge-playwright-reports/**",
        "$TURBO_ROOT$/.github/actions/playwright-quantic/**",
        "$TURBO_ROOT$/.github/actions/post-scratch-org-links-on-pr/**",
        "$TURBO_ROOT$/.github/actions/setup/**",
        "$TURBO_ROOT$/.github/actions/setup-sfdx/**",
        "$TURBO_ROOT$/.github/workflows/ci.yml",
        "$TURBO_ROOT$/.github/workflows/e2e-quantic.yml"
      ],
      "outputs": ["playwright-report/**", "blob-report/**", "test-results/**"],
      "cache": false
    },
    "e2e:prepare": {
      "dependsOn": ["build:staticresources", "validate:e2e-task-contracts"],
      "outputs": []
    },
    "e2e:playwright": {
      "dependsOn": ["@coveo/platform-mock-api#build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["playwright-report/**", "blob-report/**", "test-results/**"],
      "cache": false
    },
    "validate:e2e-task-contracts": {
      "inputs": [
        "package.json",
        "turbo.json",
        "$TURBO_ROOT$/scripts/ci/validate-quantic-e2e-contracts.test.mjs"
      ],
      "outputs": [],
      "cache": false
    },
    "validate:types": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "validate:types:build-scripts": {
      "outputs": []
    },
    "lint:check:eslint": {
      "inputs": [
        "package.json",
        "force-app/main/default/.eslintrc.json",
        "force-app/main/default/lwc/**",
        "force-app/examples/main/lwc/**"
      ],
      "outputs": []
    },
    "lint:check:prettier": {
      "inputs": [
        "package.json",
        ".prettierrc.js",
        "force-app/**/*.js",
        "force-app/**/*.cls",
        "force-app/**/*.trigger"
      ],
      "outputs": []
    },
    "lint:check:all": {
      "extends": false,
      "dependsOn": ["lint:check:eslint", "lint:check:prettier", "//#lint:check:cspell"],
      "outputs": []
    },
    "lint:fix:eslint": {
      "inputs": [
        "package.json",
        "force-app/main/default/.eslintrc.json",
        "force-app/main/default/lwc/**",
        "force-app/examples/main/lwc/**"
      ],
      "outputs": []
    },
    "lint:fix:prettier": {
      "inputs": [
        "package.json",
        ".prettierrc.js",
        "force-app/**/*.js",
        "force-app/**/*.cls",
        "force-app/**/*.trigger"
      ],
      "outputs": []
    },
    "lint:fix:all": {
      "extends": false,
      "dependsOn": ["lint:fix:eslint", "lint:fix:prettier", "//#lint:check:cspell"],
      "outputs": []
    }
  }
}
