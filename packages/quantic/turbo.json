{
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["build:staticresources", "build:doc", "babel:headless"],
      "outputs": []
    },
    "build:staticresources": {
      "dependsOn": ["^build", "babel:headless"],
      "outputs": [
        "force-app/main/default/staticresources/coveobueno/**",
        "force-app/main/default/staticresources/coveoheadless/**",
        "force-app/main/default/staticresources/dompurify/**",
        "force-app/main/default/staticresources/marked/**",
        "force-app/solutionExamples/main/staticresources/coveoua/**"
      ]
    },
    "build:doc": {
      "dependsOn": ["^build"],
      "outputs": ["docs/out/**"]
    },
    "babel:headless": {
      "dependsOn": ["^build"],
      "outputs": [".tmp/quantic-compiled/**"]
    },
    "promote:sfdx": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "promote:sfdx:ci": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test": {
      "outputs": [],
      "dependsOn": [
        "test:build-scripts",
        "test:unit",
        "validate:types",
        "validate:types:build-scripts"
      ]
    },
    "test:build-scripts": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.github/actions/apex-unit-tests/action.yml",
        "$TURBO_ROOT$/.github/actions/e2e-quantic-setup/action.yml",
        "$TURBO_ROOT$/.github/actions/playwright-quantic/action.yml",
        "$TURBO_ROOT$/.github/actions/post-scratch-org-links-on-pr/action.yml",
        "$TURBO_ROOT$/.github/scripts/e2e-quantic-workflow.node-test.mjs",
        "$TURBO_ROOT$/.github/scripts/fake-salesforce.node-test-helper.mjs",
        "$TURBO_ROOT$/.github/scripts/quantic-scratch-org-handoff.mjs",
        "$TURBO_ROOT$/.github/scripts/quantic-scratch-org-handoff.node-test.mjs",
        "$TURBO_ROOT$/.github/scripts/salesforce-scratch-org.mjs",
        "$TURBO_ROOT$/.github/scripts/salesforce-scratch-org.node-test.mjs",
        "$TURBO_ROOT$/.github/workflows/e2e-quantic.yml"
      ],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "e2e": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["playwright-report/**", "blob-report/**", "test-results/**"],
      "cache": false
    },
    "validate:types": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "validate:types:build-scripts": {
      "outputs": []
    },
    "lint:check:eslint": {
      "inputs": [
        "package.json",
        "force-app/main/default/.eslintrc.json",
        "force-app/main/default/lwc/**",
        "force-app/examples/main/lwc/**"
      ],
      "outputs": []
    },
    "lint:check:prettier": {
      "inputs": [
        "package.json",
        ".prettierrc.js",
        "force-app/**/*.js",
        "force-app/**/*.cls",
        "force-app/**/*.trigger"
      ],
      "outputs": []
    },
    "lint:check:all": {
      "extends": false,
      "dependsOn": ["lint:check:eslint", "lint:check:prettier", "//#lint:check:cspell"],
      "outputs": []
    },
    "lint:fix:eslint": {
      "inputs": [
        "package.json",
        "force-app/main/default/.eslintrc.json",
        "force-app/main/default/lwc/**",
        "force-app/examples/main/lwc/**"
      ],
      "outputs": []
    },
    "lint:fix:prettier": {
      "inputs": [
        "package.json",
        ".prettierrc.js",
        "force-app/**/*.js",
        "force-app/**/*.cls",
        "force-app/**/*.trigger"
      ],
      "outputs": []
    },
    "lint:fix:all": {
      "extends": false,
      "dependsOn": ["lint:fix:eslint", "lint:fix:prettier", "//#lint:check:cspell"],
      "outputs": []
    }
  }
}
