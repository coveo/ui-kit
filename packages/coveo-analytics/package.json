{
  "name": "coveo.analytics",
  "version": "2.30.56",
  "description": "📈 Coveo analytics client (node and browser compatible) ",
  "license": "MIT",
  "author": "Coveo",
  "repository": {
    "type": "git",
    "url": "https://github.com/coveo/coveo.analytics.js.git"
  },
  "files": [
    "modules/",
    "dist/**/*.d.ts",
    "dist/**/*.js",
    "dist/**/*.mjs",
    "dist/**/*.cjs",
    "dist/**/*.js.map",
    "dist/**/*.mjs.map",
    "dist/**/*.cjs.map",
    "src/**/*.ts",
    "react-native/",
    "LICENSE"
  ],
  "main": "dist/library.cjs",
  "module": "dist/browser.mjs",
  "browser": "dist/coveoua.browser.js",
  "types": "dist/definitions/coveoua/library.d.ts",
  "scripts": {
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "build": "rollup -c",
    "start": "rollup -c -w --environment SERVE",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare-deploy": "mkdir -p deploy && cp dist/coveoua*.js dist/coveoua*.js.map deploy",
    "clean": "rimraf -rf dist dist_test coverage"
  },
  "dependencies": {
    "@types/uuid": "9.0.8",
    "cross-fetch": "3.2.0",
    "react-native-get-random-values": "1.11.0",
    "uuid": "9.0.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.23.2",
    "@rollup/plugin-alias": "5.1.1",
    "@rollup/plugin-commonjs": "24.1.0",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "15.3.1",
    "@rollup/plugin-replace": "5.0.7",
    "@rollup/plugin-terser": "0.4.4",
    "@types/node": "6.14.13",
    "fetch-mock": "9.11.0",
    "jsdom": "28.1.0",
    "node-fetch": "2.7.0",
    "prettier": "3.9.5",
    "rimraf": "6.1.3",
    "rollup": "3.29.5",
    "rollup-plugin-copy": "3.5.0",
    "rollup-plugin-serve": "1.1.1",
    "rollup-plugin-typescript2": "0.34.1",
    "tslib": "2.8.1",
    "typescript": "5.0.4",
    "vitest": "catalog:"
  },
  "overrides": {
    "plist": "3.1.1"
  }
}
