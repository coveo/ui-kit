{
  "name": "coveo.analytics",
  "version": "2.33.0",
  "description": "📈 Coveo analytics client (node and browser compatible) ",
  "license": "MIT",
  "author": "Coveo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coveo/ui-kit.git",
    "directory": "packages/coveo-analytics"
  },
  "files": [
    "modules/",
    "dist/**/*.d.ts",
    "dist/**/*.d.mts",
    "dist/**/*.js",
    "dist/**/*.mjs",
    "dist/**/*.cjs",
    "dist/**/*.js.map",
    "dist/**/*.mjs.map",
    "dist/**/*.cjs.map",
    "src/**/*.ts",
    "react-native/",
    "LICENSE"
  ],
  "main": "dist/library.cjs",
  "module": "dist/browser.mjs",
  "browser": "dist/coveoua.browser.js",
  "types": "dist/definitions/coveoua/library.d.ts",
  "scripts": {
    "publint": "publint",
    "build": "rollup -c",
    "start": "rollup -c -w --environment SERVE",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare-deploy": "mkdir -p deploy && cp dist/coveoua*.js dist/coveoua*.js.map deploy",
    "clean": "node ../../utils/ci/rm-rf.mjs dist coverage"
  },
  "dependencies": {
    "cross-fetch": "4.1.0",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "6.0.0",
    "@rollup/plugin-commonjs": "catalog:",
    "@rollup/plugin-json": "catalog:",
    "@rollup/plugin-node-resolve": "catalog:",
    "@rollup/plugin-replace": "catalog:",
    "@rollup/plugin-terser": "catalog:",
    "@rollup/plugin-typescript": "catalog:",
    "@types/node": "catalog:",
    "fetch-mock": "12.6.0",
    "jsdom": "catalog:",
    "node-fetch": "3.3.2",
    "publint": "catalog:",
    "react-native-get-random-values": "2.0.0",
    "rollup": "catalog:",
    "rollup-plugin-copy": "3.5.0",
    "rollup-plugin-serve": "3.0.0",
    "tslib": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.11.0 || ^24.11.0"
  }
}
