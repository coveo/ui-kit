{
  "name": "@coveo/thermidor",
  "version": "0.10.0",
  "description": "Experimental package for a unified, framework-agnostic headless engine for search and conversational experiences",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coveo/ui-kit.git",
    "directory": "packages/thermidor"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./private": {
      "types": "./dist/private.d.ts",
      "import": "./dist/private.js",
      "default": "./dist/private.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "publint": "publint",
    "build": "tsdown",
    "build:typedoc": "typedoc --tsconfig tsconfig.typedoc.json",
    "check:typedoc": "typedoc --tsconfig tsconfig.typedoc.json --treatWarningsAsErrors --emit none",
    "check:typedoc:private": "typedoc --tsconfig tsconfig.typedoc.json --options typedoc.private.json --treatWarningsAsErrors",
    "clean": "node ../../utils/ci/rm-rf.mjs dist",
    "test": "vitest run && pnpm run check:typedoc && pnpm run check:typedoc:private",
    "test:watch": "vitest",
    "test:dts": "api-extractor run --local && api-extractor run --local --config api-extractor.private.json",
    "test:dts:ci": "api-extractor run && api-extractor run --config api-extractor.private.json",
    "size": "node ../../scripts/size-limit.mjs run"
  },
  "dependencies": {
    "@ag-ui/core": "0.0.59"
  },
  "devDependencies": {
    "@coveo/documentation": "workspace:*",
    "@microsoft/api-extractor": "7.60.1",
    "@size-limit/preset-small-lib": "catalog:",
    "fast-check": "4.10.2",
    "publint": "catalog:",
    "size-limit": "catalog:",
    "tsdown": "0.23.7",
    "typedoc": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "zod": "3.25.76 || ^4"
  },
  "engines": {
    "node": "^22.11.0 || ^24.11.0"
  }
}
