{
  "name": "@coveo/thermidor",
  "version": "0.1.0",
  "description": "Experimental package for a unified, framework-agnostic headless engine for search and conversational experiences",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coveo/ui-kit.git",
    "directory": "packages/thermidor"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "publint": "publint",
    "build": "tsdown",
    "clean": "node ../../utils/ci/rm-rf.mjs dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:dts": "api-extractor run --local",
    "test:dts:ci": "api-extractor run"
  },
  "dependencies": {
    "@ag-ui/core": "0.0.59"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.59.1",
    "fast-check": "4.9.0",
    "publint": "catalog:",
    "tsdown": "0.23.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "zod": "catalog:"
  },
  "engines": {
    "node": "^22.11.0 || ^24.11.0"
  }
}
